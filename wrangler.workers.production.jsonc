{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akyodex-workers-production",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "akyodex-workers-production"
    }
  ],
  "vars": {
    "CLOUDFLARE_DEPLOY_TARGET": "workers",
    "NEXT_PUBLIC_APP_URL": "https://akyodex.com",
    "NEXT_PUBLIC_SITE_URL": "https://akyodex.com",
    "NEXT_PUBLIC_R2_BASE": "https://images.akyodex.com",
    "NEXT_PUBLIC_REFERENCE_R2_BASE": "https://images.akyodex.com/reference",
    "NEXT_PUBLIC_USE_JSON_DATA": "true",
    "NEXT_PUBLIC_USE_KV_DATA": "true",
    "AKYODEX_DEPLOYMENT_ENVIRONMENT": "production",
    "SENTRY_ENVIRONMENT": "production",
    "GITHUB_REPO_OWNER": "rad-vrc",
    "GITHUB_REPO_NAME": "Akyodex",
    "GITHUB_BRANCH": "main",
    "GITHUB_CSV_PATH_JA": "data/akyo-data-ja.csv"
  },
  "kv_namespaces": [
    {
      "binding": "AKYO_KV",
      "id": "42b435eff5ca4de9a33d70faff6c6abc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AKYO_BUCKET",
      "bucket_name": "akyo-images"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "akyodex-workers-production-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "akyodex-next-tag-cache-production",
      "database_id": "e7415ce9-4544-4bec-bb4b-f944df17d153"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler"
      ]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
