{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akyodex-workers-staging",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "staging.akyodex.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "akyodex-workers-staging"
    }
  ],
  "vars": {
    "CLOUDFLARE_DEPLOY_TARGET": "workers",
    "NEXT_PUBLIC_APP_URL": "https://staging.akyodex.com",
    "NEXT_PUBLIC_SITE_URL": "https://staging.akyodex.com",
    "NEXT_PUBLIC_R2_BASE": "https://images.akyodex.com",
    "NEXT_PUBLIC_REFERENCE_R2_BASE": "https://images-staging.akyodex.com/reference",
    "NEXT_PUBLIC_USE_JSON_DATA": "true",
    "NEXT_PUBLIC_USE_KV_DATA": "true",
    "AKYODEX_DEPLOYMENT_ENVIRONMENT": "staging",
    "SENTRY_ENVIRONMENT": "staging",
    "GITHUB_REPO_OWNER": "rad-vrc",
    "GITHUB_REPO_NAME": "Akyodex",
    "GITHUB_BRANCH": "workers-staging-data",
    "GITHUB_CSV_PATH_JA": "data/akyo-data-ja.csv"
  },
  "kv_namespaces": [
    {
      "binding": "AKYO_KV",
      "id": "6ba03820093a45bf8c69c65c5b0b399f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AKYO_BUCKET",
      "bucket_name": "akyodex-workers-staging-data"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "akyodex-workers-staging-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "akyodex-next-tag-cache",
      "database_id": "1484cf52-987d-4861-9590-99d77cd40390"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler"
      ]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LOGIN_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
