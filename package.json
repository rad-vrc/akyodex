{
  "name": "akyodex-nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run catalog:snapshots && next dev --turbopack",
    "next:build": "npm run catalog:snapshots && next build",
    "next:build:opennext": "npm run catalog:snapshots && next build && node scripts/fix-opennext-instrumentation.js",
    "build": "npm run catalog:snapshots && cross-env CLOUDFLARE_DEPLOY_TARGET=pages opennextjs-cloudflare build && node scripts/prepare-cloudflare-pages.js",
    "build:workers": "cross-env CLOUDFLARE_DEPLOY_TARGET=workers opennextjs-cloudflare build --config wrangler.workers.jsonc",
    "build:workers:production": "cross-env CLOUDFLARE_DEPLOY_TARGET=workers opennextjs-cloudflare build --config wrangler.workers.production.jsonc",
    "preview:workers": "cross-env CLOUDFLARE_DEPLOY_TARGET=workers opennextjs-cloudflare preview --config wrangler.workers.jsonc",
    "deploy:workers:built": "cross-env CLOUDFLARE_DEPLOY_TARGET=workers opennextjs-cloudflare deploy --config wrangler.workers.jsonc",
    "deploy:workers:staging": "npm run build:workers && npm run deploy:workers:built",
    "dry-run:workers": "wrangler deploy --dry-run --config wrangler.workers.jsonc",
    "dry-run:workers:production": "wrangler versions upload --dry-run --config wrangler.workers.production.jsonc",
    "types:workers": "wrangler types cloudflare-env.d.ts --config wrangler.workers.jsonc --env-file wrangler-types.env --include-runtime false --env-interface CloudflareWorkerBindings --strict-vars false",
    "check:types:workers": "npm run types:workers -- --check",
    "start": "next start",
    "lint": "eslint",
    "verify:dify-csp-hash": "node scripts/verify-dify-csp-hash.js",
    "knip": "knip",
    "social:generate": "node scripts/generate-social-images.js",
    "social:compress": "node scripts/compress-social-images.js",
    "test": "playwright test",
    "test:playwright": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:worker": "tsx --test workers/akyo-search-worker/src/*.test.ts scripts/generate-vectorize-payload.test.js scripts/upload-vectorize-data.test.js",
    "typecheck:worker": "tsc -p workers/akyo-search-worker/tsconfig.json",
    "build:worker": "wrangler deploy --dry-run --config workers/akyo-search-worker/wrangler.jsonc",
    "test:csv": "node scripts/test-csv-quality.js",
    "data:convert": "npx tsx scripts/csv-to-json.ts",
    "catalog:snapshots": "tsx scripts/generate-catalog-snapshots.ts",
    "generate-ko-data": "node scripts/generate-ko-data.js",
    "push:check-pr": "node scripts/push-and-check-pr-conflicts.js",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.3",
    "@sentry/cloudflare": "^10.66.0",
    "@sentry/nextjs": "^10.66.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.6"
  },
  "overrides": {
    "minimatch": "10.2.4",
    "router": {
      "path-to-regexp": "8.4.2"
    },
    "eslint": {
      "ajv": "6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "6.14.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "knip": "^5.66.4",
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "wrangler": "^4.126.0"
  }
}
